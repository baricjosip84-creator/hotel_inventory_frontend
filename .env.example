# Local development: Vite proxies /api to the backend.
VITE_API_BASE_URL=/api

# For production, set the actual backend hostname in Vercel project settings.
# VITE_API_BASE_URL=https://<backend-host>/api

# Optional frontend request concurrency.
VITE_API_MAX_CONCURRENT_REQUESTS=4

# Public configuration governance placeholders. Do not store credentials here.
PUBLIC_CONFIG_CHANGE_APPROVER_ROLE=platform_admin
PUBLIC_CONFIG_CHANGE_APPROVAL_REQUIRED=true

# Public feature flags; VITE_ values are visible to browser users.
VITE_FEATURE_FLAGS_ENABLED=false
VITE_FEATURE_FLAG_PROVIDER=deployment-config
VITE_FEATURE_FLAG_DEFAULT_ROLLOUT_PERCENT=0

# Deployment-readiness example configuration (non-secret).
DEPLOYMENT_FRONTEND_URL=https://app.example.com
DEPLOYMENT_BACKEND_URL=https://api.example.com
DEPLOYMENT_REQUIRE_DECISION_INTELLIGENCE=true
DEPLOYMENT_REQUIRE_PLATFORM_AUTH=false
DEPLOYMENT_REQUIRE_SENTRY_SOURCE_MAPS=false
# Configure any E2E test account credentials privately in CI secrets.

# Optional browser monitoring. An empty DSN disables Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional build-only Sentry source maps. Keep upload credentials private.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_SOURCE_MAPS_REQUIRED=false
SENTRY_ALLOW_FAILURE=false
# VERCEL_GIT_COMMIT_SHA supplies the release automatically unless overridden.
# SENTRY_RELEASE=
