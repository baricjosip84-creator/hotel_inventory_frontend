# Local development: Vite dev server proxies /api to the local backend.
VITE_API_BASE_URL=/api

# Deployed Vercel app: set this under Vercel Project Settings > Environment Variables,
# with the REAL Render backend hostname. Do not commit the live URL or secrets.
# VITE_API_BASE_URL=https://<backend-host>/api

# Optional: frontend request concurrency, default 4.
VITE_API_MAX_CONCURRENT_REQUESTS=4

# Optional client-side runtime error monitoring. Empty DSN disables Sentry.
# Browser-facing VITE_ settings must never contain Sentry upload credentials.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional production build-only Sentry source-map upload.
# Configure the secret upload credential privately in provider settings; never commit it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_SOURCE_MAPS_REQUIRED=false
DEPLOYMENT_REQUIRE_SENTRY_SOURCE_MAPS=false
# A source-map upload failure must not be silently ignored.
SENTRY_ALLOW_FAILURE=false
